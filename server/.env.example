# ===== КОНФИГУРАЦИЯ СЕРВЕРА =====
# Скопируйте этот файл в .env и заполните значения

# Порт сервера
PORT=3000

# Telegram Bot Token (получить у @BotFather)
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# iCafeCloud API
ICAFE_API_URL=https://cp.icafecloud.com/api
ICAFE_API_KEY=YOUR_ICAFE_API_KEY

# iCafeCloud credentials (для авторизации пользователей)
ICAFE_CLUB_ID=YOUR_CLUB_ID

# URL фронтенда (для CORS)
# Если фронтенд на том же сервере — оставить пустым
FRONTEND_URL=

# Режим разработки (true = пропускать валидацию Telegram)
DEV_MODE=false

# Payme (получить в merchant.payme.uz)
PAYME_MERCHANT_ID=YOUR_PAYME_MERCHANT_ID

# Click (получить в my.click.uz)
CLICK_SERVICE_ID=YOUR_CLICK_SERVICE_ID
CLICK_MERCHANT_ID=YOUR_CLICK_MERCHANT_ID
